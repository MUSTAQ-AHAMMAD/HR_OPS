<svg width="1400" height="900" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1400" height="900" fill="#f8fafc"/>

  <!-- Header Navigation -->
  <rect x="0" y="0" width="1400" height="70" fill="white"/>
  <line x1="0" y1="70" x2="1400" y2="70" stroke="#e2e8f0" stroke-width="1"/>

  <text x="30" y="45" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">🏢 HR Operations</text>
  <text x="250" y="45" font-family="Arial, sans-serif" font-size="15" fill="#3b82f6">Dashboard</text>
  <text x="360" y="45" font-family="Arial, sans-serif" font-size="15" fill="#64748b">Brands</text>
  <text x="450" y="45" font-family="Arial, sans-serif" font-size="15" fill="#64748b">Templates</text>
  <text x="570" y="45" font-family="Arial, sans-serif" font-size="15" fill="#64748b">Employees</text>
  <text x="700" y="45" font-family="Arial, sans-serif" font-size="15" fill="#64748b">Analytics</text>

  <circle cx="1320" cy="35" r="20" fill="#3b82f6"/>
  <text x="1320" y="42" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white" text-anchor="middle">A</text>

  <!-- Page Title -->
  <text x="30" y="120" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#1e293b">Dashboard</text>
  <text x="30" y="150" font-family="Arial, sans-serif" font-size="16" fill="#64748b">Welcome back! Here's what's happening.</text>

  <!-- Stats Cards Row -->
  <!-- Card 1: Total Brands -->
  <rect x="30" y="180" width="320" height="120" rx="12" fill="white"/>
  <text x="50" y="215" font-family="Arial, sans-serif" font-size="14" fill="#64748b">Total Brands</text>
  <text x="50" y="255" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#1e293b">12</text>
  <text x="50" y="285" font-family="Arial, sans-serif" font-size="13" fill="#22c55e">↑ +2 this month</text>
  <circle cx="315" cy="210" r="25" fill="#3b82f6" fill-opacity="0.1"/>
  <text x="315" y="220" font-family="Arial, sans-serif" font-size="24" fill="#3b82f6" text-anchor="middle">🏢</text>

  <!-- Card 2: Templates -->
  <rect x="370" y="180" width="320" height="120" rx="12" fill="white"/>
  <text x="390" y="215" font-family="Arial, sans-serif" font-size="14" fill="#64748b">Templates</text>
  <text x="390" y="255" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#1e293b">48</text>
  <text x="390" y="285" font-family="Arial, sans-serif" font-size="13" fill="#22c55e">↑ +8 this month</text>
  <circle cx="655" cy="210" r="25" fill="#22c55e" fill-opacity="0.1"/>
  <text x="655" y="220" font-family="Arial, sans-serif" font-size="24" fill="#22c55e" text-anchor="middle">📄</text>

  <!-- Card 3: Employees -->
  <rect x="710" y="180" width="320" height="120" rx="12" fill="white"/>
  <text x="730" y="215" font-family="Arial, sans-serif" font-size="14" fill="#64748b">Employees</text>
  <text x="730" y="255" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#1e293b">235</text>
  <text x="730" y="285" font-family="Arial, sans-serif" font-size="13" fill="#22c55e">↑ +15 this month</text>
  <circle cx="995" cy="210" r="25" fill="#f59e0b" fill-opacity="0.1"/>
  <text x="995" y="220" font-family="Arial, sans-serif" font-size="24" fill="#f59e0b" text-anchor="middle">👥</text>

  <!-- Card 4: Active Users -->
  <rect x="1050" y="180" width="320" height="120" rx="12" fill="white"/>
  <text x="1070" y="215" font-family="Arial, sans-serif" font-size="14" fill="#64748b">Active Users</text>
  <text x="1070" y="255" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#1e293b">18</text>
  <text x="1070" y="285" font-family="Arial, sans-serif" font-size="13" fill="#64748b">3 online now</text>
  <circle cx="1335" cy="210" r="25" fill="#8b5cf6" fill-opacity="0.1"/>
  <text x="1335" y="220" font-family="Arial, sans-serif" font-size="24" fill="#8b5cf6" text-anchor="middle">⚡</text>

  <!-- Quick Actions Section -->
  <text x="30" y="350" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">Quick Actions</text>

  <!-- Action Card 1 -->
  <rect x="30" y="370" width="420" height="100" rx="12" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  <circle cx="70" cy="420" r="25" fill="#3b82f6" fill-opacity="0.1"/>
  <text x="70" y="430" font-family="Arial, sans-serif" font-size="24" fill="#3b82f6" text-anchor="middle">➕</text>
  <text x="110" y="410" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1e293b">Create New Brand</text>
  <text x="110" y="432" font-family="Arial, sans-serif" font-size="13" fill="#64748b">Add a new brand with custom styling</text>

  <!-- Action Card 2 -->
  <rect x="470" y="370" width="420" height="100" rx="12" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  <circle cx="510" cy="420" r="25" fill="#22c55e" fill-opacity="0.1"/>
  <text x="510" y="430" font-family="Arial, sans-serif" font-size="24" fill="#22c55e" text-anchor="middle">📝</text>
  <text x="550" y="410" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1e293b">New Template</text>
  <text x="550" y="432" font-family="Arial, sans-serif" font-size="13" fill="#64748b">Create a template with AI assistance</text>

  <!-- Action Card 3 -->
  <rect x="910" y="370" width="460" height="100" rx="12" fill="white" stroke="#e2e8f0" stroke-width="2"/>
  <circle cx="950" cy="420" r="25" fill="#f59e0b" fill-opacity="0.1"/>
  <text x="950" y="430" font-family="Arial, sans-serif" font-size="24" fill="#f59e0b" text-anchor="middle">🔄</text>
  <text x="990" y="410" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1e293b">Sync Employees</text>
  <text x="990" y="432" font-family="Arial, sans-serif" font-size="13" fill="#64748b">Update employee data from Outlook</text>

  <!-- Recent Activity Section -->
  <text x="30" y="520" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">Recent Activity</text>

  <rect x="30" y="540" width="1340" height="320" rx="12" fill="white"/>

  <!-- Activity Items -->
  <circle cx="60" cy="580" r="20" fill="#3b82f6"/>
  <text x="60" y="588" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white" text-anchor="middle">A</text>
  <text x="95" y="575" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1e293b">Admin User</text>
  <text x="95" y="595" font-family="Arial, sans-serif" font-size="13" fill="#64748b">created a new brand Acme Corporation</text>
  <text x="1320" y="585" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8" text-anchor="end">2 hours ago</text>

  <line x1="60" y1="600" x2="60" y2="640" stroke="#e2e8f0" stroke-width="2"/>

  <circle cx="60" cy="660" r="20" fill="#22c55e"/>
  <text x="60" y="668" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white" text-anchor="middle">J</text>
  <text x="95" y="655" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1e293b">Jane Smith</text>
  <text x="95" y="675" font-family="Arial, sans-serif" font-size="13" fill="#64748b">updated template Welcome Email</text>
  <text x="1320" y="665" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8" text-anchor="end">4 hours ago</text>

  <line x1="60" y1="680" x2="60" y2="720" stroke="#e2e8f0" stroke-width="2"/>

  <circle cx="60" cy="740" r="20" fill="#f59e0b"/>
  <text x="60" y="748" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white" text-anchor="middle">S</text>
  <text x="95" y="735" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1e293b">System</text>
  <text x="95" y="755" font-family="Arial, sans-serif" font-size="13" fill="#64748b">synced 235 employees from Outlook</text>
  <text x="1320" y="745" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8" text-anchor="end">6 hours ago</text>

  <line x1="60" y1="760" x2="60" y2="800" stroke="#e2e8f0" stroke-width="2"/>

  <circle cx="60" cy="820" r="20" fill="#8b5cf6"/>
  <text x="60" y="828" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white" text-anchor="middle">M</text>
  <text x="95" y="815" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1e293b">Mike Johnson</text>
  <text x="95" y="835" font-family="Arial, sans-serif" font-size="13" fill="#64748b">published template Onboarding Guide</text>
  <text x="1320" y="825" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8" text-anchor="end">1 day ago</text>
</svg>