<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- Background Gradient -->
  <defs>
    <linearGradient id="bg-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#64748b;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="url(#bg-gradient)"/>

  <!-- Header -->
  <rect x="0" y="0" width="1200" height="80" fill="white" fill-opacity="0.95"/>
  <text x="40" y="50" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#1e293b">HR Operations</text>
  <text x="1000" y="50" font-family="Arial, sans-serif" font-size="16" fill="#64748b">Login</text>
  <text x="1100" y="50" font-family="Arial, sans-serif" font-size="16" fill="#3b82f6">Sign Up</text>

  <!-- Hero Section -->
  <text x="600" y="200" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white" text-anchor="middle">HR Operations Platform</text>
  <text x="600" y="250" font-family="Arial, sans-serif" font-size="20" fill="white" fill-opacity="0.9" text-anchor="middle">Enterprise-grade HR management with AI-powered tools</text>

  <!-- CTA Buttons -->
  <rect x="450" y="280" width="140" height="50" rx="8" fill="#3b82f6"/>
  <text x="520" y="313" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white" text-anchor="middle">Get Started</text>

  <rect x="610" y="280" width="140" height="50" rx="8" fill="white" fill-opacity="0.2" stroke="white" stroke-width="2"/>
  <text x="680" y="313" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white" text-anchor="middle">Learn More</text>

  <!-- Feature Cards -->
  <rect x="60" y="380" width="240" height="180" rx="12" fill="white" fill-opacity="0.95"/>
  <circle cx="180" cy="430" r="30" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="180" y="440" font-family="Arial, sans-serif" font-size="28" fill="#3b82f6" text-anchor="middle">🏢</text>
  <text x="180" y="500" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#1e293b" text-anchor="middle">Brand Management</text>
  <text x="180" y="530" font-family="Arial, sans-serif" font-size="14" fill="#64748b" text-anchor="middle">Create & manage brands</text>

  <rect x="320" y="380" width="240" height="180" rx="12" fill="white" fill-opacity="0.95"/>
  <circle cx="440" cy="430" r="30" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="440" y="440" font-family="Arial, sans-serif" font-size="28" fill="#3b82f6" text-anchor="middle">📄</text>
  <text x="440" y="500" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#1e293b" text-anchor="middle">Template Library</text>
  <text x="440" y="530" font-family="Arial, sans-serif" font-size="14" fill="#64748b" text-anchor="middle">AI-powered templates</text>

  <rect x="580" y="380" width="240" height="180" rx="12" fill="white" fill-opacity="0.95"/>
  <circle cx="700" cy="430" r="30" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="700" y="440" font-family="Arial, sans-serif" font-size="28" fill="#3b82f6" text-anchor="middle">👥</text>
  <text x="700" y="500" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#1e293b" text-anchor="middle">Employee Sync</text>
  <text x="700" y="530" font-family="Arial, sans-serif" font-size="14" fill="#64748b" text-anchor="middle">Outlook integration</text>

  <rect x="840" y="380" width="240" height="180" rx="12" fill="white" fill-opacity="0.95"/>
  <circle cx="960" cy="430" r="30" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="960" y="440" font-family="Arial, sans-serif" font-size="28" fill="#3b82f6" text-anchor="middle">📊</text>
  <text x="960" y="500" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#1e293b" text-anchor="middle">Analytics</text>
  <text x="960" y="530" font-family="Arial, sans-serif" font-size="14" fill="#64748b" text-anchor="middle">Real-time insights</text>

  <!-- Footer -->
  <rect x="0" y="720" width="1200" height="80" fill="black" fill-opacity="0.2"/>
  <text x="600" y="765" font-family="Arial, sans-serif" font-size="14" fill="white" fill-opacity="0.8" text-anchor="middle">© 2026 HR Operations Platform. Built with Next.js & TypeScript.</text>
</svg>